package my.magna.client

import my.magna.MagnaLimits
import my.magna.MagnetSettings
import my.magna.PullSpeed
import my.magna.Targets
import net.minecraft.ChatFormatting
import net.minecraft.client.gui.GuiGraphicsExtractor
import net.minecraft.client.gui.screens.Screen
import net.minecraft.client.input.MouseButtonEvent
import net.minecraft.network.chat.Component
import net.minecraft.world.item.ItemStack
import net.minecraft.world.item.Items

class MagnaScreen(private val parent: Screen? = null) : Screen(Component.literal("Magna")) {
    private val d: MagnetSettings get() = ClientSettings.data
    private val qualityNames = listOf("Off", "Light", "Full")
    private val hopper = ItemStack(Items.HOPPER)

    private var pX = 0
    private var pY = 0
    private var pW = 270
    private var pH = 0
    private var pitch = 40
    private var base = 0
    private var powerR = UiRect(0, 0, 0, 0)
    private var trackR = UiRect(0, 0, 0, 0)
    private var sliderHit = UiRect(0, 0, 0, 0)
    private var speedR = UiRect(0, 0, 0, 0)
    private var targetsR = UiRect(0, 0, 0, 0)
    private var effectsR = UiRect(0, 0, 0, 0)
    private var filterR = UiRect(0, 0, 0, 0)
    private var doneR = UiRect(0, 0, 0, 0)
    private var dragging = false
    private var switchAnim = 0f

    private fun commit() {
        ClientSettings.save()
        MagnaClient.pushSettings()
    }

    private fun setRangeFromMouse(mx: Double) {
        val min = MagnaLimits.MIN_RANGE
        val max = MagnaLimits.MAX_RANGE
        val t = ((mx - trackR.x - 4) / (trackR.w - 8).toDouble()).coerceIn(0.0, 1.0)
        d.range = min + Math.round(t * (max - min)).toInt()
    }

    override fun onClose() {
        if (parent != null) MagnaClient.openScreen(parent) else super.onClose()
    }

    override fun init() {
        val headerH = 44
        val filterH = 30
        val doneH = 20
        val gap = 8
        val fixed = headerH + filterH + gap + doneH + 12
        pW = minOf(270, width - 12)
        pitch = ((height - 12 - fixed) / 4).coerceIn(34, 46)
        pH = fixed + 4 * pitch
        pX = (width - pW) / 2
        pY = ((height - pH) / 2).coerceAtLeast(4)
        base = pY + headerH

        val ix = pX + 16
        val iw = pW - 32
        powerR = UiRect(pX + pW - 16 - 90, pY + 8, 90, 26)
        trackR = UiRect(ix, base + 20, iw, 6)
        sliderHit = UiRect(ix, base + 8, iw, 28)
        speedR = UiRect(ix, base + pitch + 13, iw, 20)
        targetsR = UiRect(ix, base + 2 * pitch + 13, iw, 20)
        effectsR = UiRect(ix, base + 3 * pitch + 13, iw, 20)
        filterR = UiRect(ix, base + 4 * pitch, iw, filterH)
        doneR = UiRect(ix, base + 4 * pitch + filterH + gap, iw, doneH)
        switchAnim = if (d.enabled) 1f else 0f
    }

    private fun section(g: GuiGraphicsExtractor, index: Int, title: String, value: String?) {
        val y = base + index * pitch
        MagnaUi.text(g, font, Component.literal(title), pX + 16, y, MagnaUi.MUTED)
        if (value != null) {
            MagnaUi.textRight(
                g, font, Component.literal(value).withStyle(ChatFormatting.BOLD),
                pX + pW - 16, y, MagnaUi.TEXT
            )
        }
    }

    override fun extractRenderState(g: GuiGraphicsExtractor, mx: Int, my: Int, delta: Float) {
        super.extractRenderState(g, mx, my, delta)
        val dmx = mx.toDouble()
        val dmy = my.toDouble()
        val on = d.enabled
        val accent = if (on) MagnaUi.ACCENT else MagnaUi.OFF

        switchAnim += ((if (on) 1f else 0f) - switchAnim) * 0.35f

        // اللوحة
        MagnaUi.card(g, pX, pY, pW, pH, MagnaUi.PANEL, MagnaUi.BORDER)
        MagnaUi.gradient(g, pX + 1, pY + 1, pW - 2, 2, MagnaUi.ACCENT, MagnaUi.ACCENT2)

        // الرأس
        MagnaUi.text(g, font, Component.literal("MAGNA").withStyle(ChatFormatting.BOLD), pX + 16, pY + 11, MagnaUi.TEXT)
        MagnaUi.text(g, font, Component.literal("Item Magnet"), pX + 16, pY + 24, MagnaUi.MUTED)

        // مفتاح التشغيل
        val swX = pX + pW - 16 - 36
        val swY = pY + 12
        val swColor = MagnaUi.mix(MagnaUi.OFF, MagnaUi.GOOD, switchAnim)
        MagnaUi.rounded(g, swX, swY, 36, 18, swColor)
        val knobX = swX + 2 + (18 * switchAnim).toInt()
        MagnaUi.rounded(g, knobX, swY + 2, 14, 14, MagnaUi.WHITE)
        MagnaUi.textRight(
            g, font, Component.literal(if (on) "ON" else "OFF").withStyle(ChatFormatting.BOLD),
            swX - 8, swY + 5, if (on) MagnaUi.GOOD else MagnaUi.MUTED
        )
        g.fill(pX + 16, pY + 38, pX + pW - 16, pY + 39, MagnaUi.BORDER)

        // 1) المدى (سلايدر)
        section(g, 0, "Pickup range", "${d.range} blocks")
        val min = MagnaLimits.MIN_RANGE
        val max = MagnaLimits.MAX_RANGE
        val t = if (max > min) (d.range - min).toFloat() / (max - min) else 0f
        MagnaUi.rounded(g, trackR.x, trackR.y, trackR.w, trackR.h, MagnaUi.CARD)
        val kx = trackR.x + ((trackR.w - 8) * t).toInt()
        val fillW = kx + 4 - trackR.x
        if (fillW > 2) MagnaUi.gradient(g, trackR.x, trackR.y, fillW, trackR.h, accent, if (on) MagnaUi.ACCENT2 else accent)
        val knobHover = dragging || sliderHit.hit(dmx, dmy)
        MagnaUi.rounded(g, kx, trackR.y - 5, 8, 16, if (knobHover) MagnaUi.WHITE else 0xFFD5D9EE.toInt())

        // 2) السرعة
        section(g, 1, "Pull speed", null)
        MagnaUi.segmented(g, font, speedR, PullSpeed.entries.map { it.label }, d.speed, mx, my, accent)

        // 3) نوع الجمع
        section(g, 2, "Collect", null)
        MagnaUi.segmented(g, font, targetsR, Targets.entries.map { it.label }, d.targets, mx, my, accent)

        // 4) المؤثرات
        section(g, 3, "Effects", null)
        MagnaUi.segmented(g, font, effectsR, qualityNames, d.quality, mx, my, accent)

        // بطاقة الفلتر
        val fHover = filterR.hit(dmx, dmy)
        MagnaUi.card(g, filterR.x, filterR.y, filterR.w, filterR.h, if (fHover) MagnaUi.CARD_HOVER else MagnaUi.CARD, MagnaUi.BORDER)
        g.item(hopper, filterR.x + 8, filterR.y + 7)
        MagnaUi.text(g, font, Component.literal("Item filter"), filterR.x + 32, filterR.y + 6, MagnaUi.TEXT)
        val count = d.filterItems.size
        val whitelist = d.filterWhitelist
        val emptyWhite = whitelist && count == 0
        val sub = if (emptyWhite) "Whitelist is empty" else "${if (whitelist) "Whitelist" else "Blacklist"} \u00B7 $count items"
        MagnaUi.text(g, font, Component.literal(sub), filterR.x + 32, filterR.y + 17, if (emptyWhite) MagnaUi.WARN else MagnaUi.MUTED)
        MagnaUi.textRight(g, font, Component.literal("\u203A"), filterR.x + filterR.w - 10, filterR.y + 11, MagnaUi.MUTED)

        // زر Done
        val dHover = doneR.hit(dmx, dmy)
        MagnaUi.rounded(g, doneR.x, doneR.y, doneR.w, doneR.h, if (dHover) MagnaUi.mix(MagnaUi.ACCENT, MagnaUi.WHITE, 0.18f) else MagnaUi.ACCENT)
        MagnaUi.textCenter(g, font, Component.literal("Done").withStyle(ChatFormatting.BOLD), doneR.x + doneR.w / 2, doneR.y + 6, MagnaUi.WHITE)
    }

    override fun mouseClicked(event: MouseButtonEvent, doubleClick: Boolean): Boolean {
        if (super.mouseClicked(event, doubleClick)) return true
        val mx = event.x()
        val my = event.y()

        when {
            powerR.hit(mx, my) -> {
                d.enabled = !d.enabled
                MagnaUi.click(); commit()
            }
            sliderHit.hit(mx, my) -> {
                dragging = true
                setRangeFromMouse(mx)
            }
            speedR.hit(mx, my) -> {
                d.speed = MagnaUi.segIndex(speedR, PullSpeed.entries.size, mx)
                MagnaUi.click(); commit()
            }
            targetsR.hit(mx, my) -> {
                d.targets = MagnaUi.segIndex(targetsR, Targets.entries.size, mx)
                MagnaUi.click(); commit()
            }
            effectsR.hit(mx, my) -> {
                d.quality = MagnaUi.segIndex(effectsR, qualityNames.size, mx)
                MagnaUi.click(); commit()
            }
            filterR.hit(mx, my) -> {
                MagnaUi.click()
                MagnaClient.openScreen(MagnaFilterScreen(this))
            }
            doneR.hit(mx, my) -> {
                MagnaUi.click()
                onClose()
            }
            else -> return false
        }
        return true
    }

    override fun mouseDragged(event: MouseButtonEvent, dx: Double, dy: Double): Boolean {
        if (dragging) {
            setRangeFromMouse(event.x())
            return true
        }
        return super.mouseDragged(event, dx, dy)
    }

    override fun mouseReleased(event: MouseButtonEvent): Boolean {
        if (dragging) {
            dragging = false
            commit()
            return true
        }
        return super.mouseReleased(event)
    }
}
